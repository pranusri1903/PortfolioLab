# --- API (copy to .env; never commit real values) ---
POSTGRES_PASSWORD=change-me
AUTH_MODE=dev                # "dev" accepts "Bearer dev:<user_id>" (local only!). Use "clerk" in production.
CLERK_JWKS_URL=              # e.g. https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=                # e.g. https://<your-instance>.clerk.accounts.dev
CORS_ORIGINS=http://localhost:3000
RISK_FREE_RATE=0.02

# --- Live market data (optional; without it only the sample assets are available) ---
TWELVE_DATA_API_KEY=         # stocks & ETFs (US; NSE/BSE if your plan includes them). Indian mutual funds need no key.
CRON_SECRET=                 # long random string; the daily GitHub Action sends it as X-Cron-Secret
BENCHMARK_USD=BNCH           # use SPY once live data is on
BENCHMARK_INR=NIFB           # use NIFTYBEES.NS once live data is on

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # leave empty to use the local dev sign-in
CLERK_SECRET_KEY=
