# --- API (copy to .env; never commit real values) ---
POSTGRES_PASSWORD=change-me
AUTH_MODE=dev                # "dev" accepts "Bearer dev:<user_id>" (local only!). Use "clerk" in production.
CLERK_JWKS_URL=              # e.g. https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=                # e.g. https://<your-instance>.clerk.accounts.dev
CORS_ORIGINS=http://localhost:3000
RISK_FREE_RATE=0.02

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # leave empty to use the local dev sign-in
CLERK_SECRET_KEY=
